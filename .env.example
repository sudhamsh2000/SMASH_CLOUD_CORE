# ─────────────────────────────────────────────────────────────
# SMASH Cloud configuration. Copy to .env and fill in.
# .env is gitignored — never commit real keys.
# After editing:  docker compose up -d --build
# ─────────────────────────────────────────────────────────────

# ── Dashboard login (single owner) ───────────────────────────
SMASH_ADMIN_USERNAME=admin
SMASH_ADMIN_PASSWORD=change-me
# Signs login tokens. Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SMASH_JWT_SECRET=change-me
SMASH_JWT_TTL_HOURS=12

# ── Database ─────────────────────────────────────────────────
POSTGRES_USER=smash
POSTGRES_PASSWORD=change-me
POSTGRES_DB=smash

# ── FRIDAY: AI providers ─────────────────────────────────────
# A provider is enabled when its key is set. You need at least one.
# Default provider when you don't pick one in the UI: anthropic | openai | gemini | ollama
FRIDAY_DEFAULT_PROVIDER=anthropic
# Tried in this order if the chosen provider fails before replying
FRIDAY_FALLBACK_ORDER=anthropic,openai,gemini,ollama

# Anthropic Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max — higher = more thorough, more tokens
ANTHROPIC_EFFORT=medium

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# "chat-latest" is an alias OpenAI keeps pointed at its current chat model; pin a specific ID if you prefer
OPENAI_MODEL=chat-latest

# Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# "gemini-flash-latest" is an alias Google keeps pointed at its current Flash model
GEMINI_MODEL=gemini-flash-latest

# Local models via Ollama running on this machine (https://ollama.com) — free, private
OLLAMA_ENABLED=false
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1

# ── FRIDAY: voice (text-to-speech) ───────────────────────────
# ElevenLabs — https://elevenlabs.io/app/settings/api-keys
# The key stays server-side: the browser asks FRIDAY for audio, FRIDAY calls ElevenLabs.
ELEVENLABS_API_KEY=
# Voice to speak with; pick one at https://elevenlabs.io/app/voice-library (copy its ID)
ELEVENLABS_VOICE_ID=
# eleven_flash_v2_5 (fast, default) or eleven_multilingual_v2 (higher quality, slower)
ELEVENLABS_MODEL=eleven_flash_v2_5

# ── Backups ──────────────────────────────────────────────────
# Postgres dumps land in ./backups on the host (outside Docker's disk image)
BACKUP_INTERVAL_HOURS=6
BACKUP_KEEP=28
